<Project Sdk="Microsoft.NET.Sdk">
  <!-- منطق المجال الصرف: لا قاعدة بيانات ولا واجهة ولا Windows. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- LibraryImport لـlibsodium يمرّر مؤشّرات إلى ذاكرة مثبّتة. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="libsodium" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Rakeeza.Core.Tests" />
  </ItemGroup>
</Project>
